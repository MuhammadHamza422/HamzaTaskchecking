{
  "info": {
    "name": "Order Fulfillment APIs",
    "description": "API collection for Order Fulfillment Module - Search and Details endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "fulfillment-module"
  },
  "item": [
    {
      "name": "Search Order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/fulfillment/orders/search?query=ORD-12345",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "fulfillment", "orders", "search"],
          "query": [
            {
              "key": "query",
              "value": "ORD-12345",
              "description": "Order ID, order number, or ShipStation packing slip barcode"
            }
          ]
        },
        "description": "Search for an order across all platforms. Returns minimal data for quick response."
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fulfillment/orders/search?query=ORD-12345",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "fulfillment", "orders", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "ORD-12345"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"orderId\": \"12345\",\n    \"orderNumber\": \"ORD-12345\",\n    \"platform\": \"shopify\",\n    \"customerName\": \"John Doe\",\n    \"status\": \"processing\",\n    \"fulfillmentStatus\": \"pending\",\n    \"createdAt\": \"2025-01-15T10:30:00Z\",\n    \"totalValue\": 299.99,\n    \"currency\": \"USD\"\n  }\n}"
        },
        {
          "name": "Not Found Response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fulfillment/orders/search?query=INVALID-123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "fulfillment", "orders", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "INVALID-123"
                }
              ]
            }
          },
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"ORDER_NOT_FOUND\",\n    \"message\": \"Order not found with the provided query\",\n    \"details\": \"No order matching 'INVALID-123' was found in any platform\"\n  }\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "your-auth-token-here",
      "type": "string"
    }
  ]
}

